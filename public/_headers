# The app's service worker must always be re-checked so new releases reach installed apps.
/app/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /app/

# The manifest can change with releases too.
/app/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build files never change, so browsers can keep them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
